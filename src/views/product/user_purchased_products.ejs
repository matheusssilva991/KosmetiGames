<%- include('../components/head.ejs', { title: 'Histórico de compras' }) %>
<div class="d-flex flex-column min-vh-100">
  <%- include('../components/header.ejs') %>
  <main class="container mt-4 mb-5 flex-grow-1">
    <h1>Histórico de compras</h1>
    <% if (!orders.length) { %><p class="alert alert-info">Nenhuma compra realizada.</p><% } %>
    <% for (const items of orders) { %>
      <section class="mb-4">
        <h2 class="h5">Pedido #<%= items[0].order_id %></h2>
        <% if (!items[0].closed_at) { %>
          <p class="text-body-secondary small">Dados estimados a partir do catálogo na data da migração.</p>
        <% } %>
        <% for (const product of items) { %>
          <article class="card mb-2">
            <div class="row g-0 align-items-center">
              <div class="col-md-2 text-center">
                <%- include('../components/product-image.ejs', { product }) %>
              </div>
              <div class="col-md">
                <div class="card-body">
                  <h3 class="h5"><%= product.name %></h3>
                  <p class="text-body-secondary mb-1"><%= product.game_name %> · <%= product.category_name %></p>
                  <p><%= product.description %></p>
                  <p class="mb-0">Quantidade: <%= product.quantity %> · Preço unitário: R$ <%= formatPrice(product.price) %></p>
                </div>
              </div>
            </div>
          </article>
        <% } %>
      </section>
    <% } %>
  </main>
  <%- include('../components/footer.ejs') %>
</div>
</body>
</html>
