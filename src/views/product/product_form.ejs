<% const editing = Boolean(data.id); %>
<% const title = editing ? 'Editar produto' : 'Cadastrar produto'; %>
<%- include('../components/head.ejs', { title }) %>
<div class="d-flex flex-column min-vh-100">
  <%- include('../components/header.ejs') %>
  <main class="container d-flex flex-column align-items-center mt-4 flex-grow-1 mb-5">
    <h1><%= title %></h1>
    <form action="<%= editing ? '/products/' + data.id + '?_method=PATCH' : '/products' %>"
          method="post" enctype="multipart/form-data" class="w-100 mt-4 bg-white p-4 rounded-2"
          style="max-width: 40rem">
      <%- include('../components/csrf.ejs') %>
      <%- include('../components/form-errors.ejs') %>
      <% if (editing) { %><input type="hidden" name="version" value="<%= data.version %>"><% } %>
      <div class="mb-4">
        <label for="name" class="form-label">Nome</label>
        <input class="form-control" id="name" name="name" value="<%= data.name %>" maxlength="255" required>
      </div>
      <div class="row g-3 mb-4">
        <div class="col">
          <label for="price" class="form-label">Preço (R$)</label>
          <input class="form-control" id="price" name="price" value="<%= data.price %>" inputmode="decimal" required>
        </div>
        <div class="col">
          <label for="stock" class="form-label">Estoque</label>
          <input class="form-control" id="stock" name="stock" type="number" value="<%= data.stock %>"
                 min="0" max="4294967295" required>
        </div>
      </div>
      <div class="row g-3 mb-4">
        <div class="col">
          <label for="game" class="form-label">Jogo</label>
          <select class="form-select" id="game" name="game_id" required>
            <option value="">Selecione</option>
            <% for (const game of games) { %>
              <option value="<%= game.id %>" <%= game.id === data.game_id ? 'selected' : '' %>><%= game.name %></option>
            <% } %>
          </select>
        </div>
        <div class="col">
          <label for="category" class="form-label">Categoria</label>
          <select class="form-select" id="category" name="category_id" required>
            <option value="">Selecione</option>
            <% for (const category of categories) { %>
              <option value="<%= category.id %>" <%= category.id === data.category_id ? 'selected' : '' %>><%= category.name %></option>
            <% } %>
          </select>
        </div>
      </div>
      <div class="mb-4">
        <label for="description" class="form-label">Descrição</label>
        <textarea class="form-control" id="description" rows="3" name="description" maxlength="8000" required><%= data.description %></textarea>
      </div>
      <div class="mb-4">
        <label for="image" class="form-label"><%= editing ? 'Substituir imagem (opcional)' : 'Imagem' %></label>
        <input class="form-control" id="image" type="file" name="image"
               accept="image/jpeg,image/png,image/webp" <%= editing ? '' : 'required' %>>
        <div class="form-text">JPEG, PNG ou WebP de até 5 MiB.</div>
      </div>
      <button class="btn btn-dark" type="submit"><%= editing ? 'Salvar' : 'Cadastrar' %></button>
    </form>
  </main>
  <%- include('../components/footer.ejs') %>
</div>
</body>
</html>
