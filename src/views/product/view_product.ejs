<%- include('../components/head.ejs', { title: product.name }) %>
<div class="d-flex flex-column min-vh-100">
  <%- include('../components/header.ejs') %>
  <main class="container mt-5 flex-grow-1 mb-5">
    <div class="card">
      <div class="row g-0">
        <div class="col-md-4 d-flex align-items-center justify-content-center">
          <%- include('../components/product-image.ejs', { product }) %>
        </div>
        <div class="col-md-8">
          <div class="card-body">
            <h1 class="h4"><%= product.name %></h1>
            <p class="text-body-secondary"><%= product.game_name %> · <%= product.category_name %></p>
            <p style="white-space: pre-line"><%= product.description %></p>
            <p class="fs-2">R$ <%= formatPrice(product.price) %></p>
            <% if (user?.id === product.user_id) { %>
              <a href="/products/<%= product.id %>/edit" class="btn btn-outline-dark">Editar</a>
            <% } else if (product.stock === 0) { %>
              <p class="text-body-secondary">Esgotado</p>
            <% } else if (user) { %>
              <form action="/cart/items" method="post" class="d-flex flex-wrap align-items-end gap-2">
                <%- include('../components/csrf.ejs') %>
                <input type="hidden" name="productId" value="<%= product.id %>">
                <div>
                  <label class="form-label" for="quantity">Quantidade</label>
                  <input class="form-control" id="quantity" type="number" name="quantity"
                         value="1" min="1" max="<%= product.stock %>" required>
                </div>
                <button type="submit" class="btn btn-dark">Adicionar ao carrinho</button>
              </form>
            <% } else { %>
              <a href="/login" class="btn btn-dark">Entrar para comprar</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('../components/footer.ejs') %>
</div>
</body>
</html>
