<%- include('../components/head.ejs', { title: 'Carrinho' }) %>
<div class="d-flex flex-column min-vh-100">
  <%- include('../components/header.ejs') %>
  <main class="container mt-4 flex-grow-1 mb-5">
    <h1>Carrinho</h1>
    <% if (error) { %><p class="alert alert-danger" role="alert"><%= error %></p><% } %>
    <% if (!cart.items.length) { %>
      <p class="alert alert-info">Seu carrinho está vazio.</p>
      <a href="/products" class="btn btn-dark">Ver produtos</a>
    <% } else { %>
      <% for (const product of cart.items) { %>
        <article class="card mb-2">
          <div class="row g-0 align-items-center">
            <div class="col-md-2 text-center">
              <%- include('../components/product-image.ejs', { product }) %>
            </div>
            <div class="col-md">
              <div class="card-body">
                <h2 class="h5"><%= product.name %></h2>
                <p class="mb-1">Quantidade: <%= product.quantity %></p>
                <% if (product.archived_at) { %>
                  <p class="text-danger mb-0">Produto indisponível.</p>
                <% } else { %>
                  <p class="mb-0">Preço unitário: R$ <%= formatPrice(product.price) %></p>
                  <% if (product.stock < product.quantity) { %>
                    <p class="text-danger mb-0">Estoque disponível: <%= product.stock %></p>
                  <% } %>
                <% } %>
              </div>
            </div>
            <form class="col-md-auto p-3" action="/cart/items/<%= product.item_id %>?_method=DELETE" method="post">
              <%- include('../components/csrf.ejs') %>
              <button type="submit" class="btn btn-outline-dark btn-sm">Remover</button>
            </form>
          </div>
        </article>
      <% } %>
      <form action="/cart/checkout" method="post" class="d-flex flex-wrap gap-3 align-items-center justify-content-end mt-4">
        <%- include('../components/csrf.ejs') %>
        <input type="hidden" name="orderId" value="<%= cart.id %>">
        <strong>Total: R$ <%= formatCents(cart.total) %></strong>
        <button type="submit" class="btn btn-dark">Finalizar compra</button>
      </form>
    <% } %>
  </main>
  <%- include('../components/footer.ejs') %>
</div>
</body>
</html>
