<article class="card" style="width: 15rem">
  <div class="text-center border-bottom">
    <%- include('../product-image.ejs', { product }) %>
  </div>
  <div class="card-body d-flex flex-column">
    <h5 class="card-title fs-6 text-body-secondary"><%= product.name.length > 30 ? product.name.slice(0, 30) + '…' : product.name %></h5>
    <p class="fs-4">R$ <%= formatPrice(product.price) %></p>
    <div class="d-flex justify-content-center align-items-center gap-2 mt-auto">
      <a href="/products/<%= product.id %>" class="btn btn-sm btn-outline-dark">Ver</a>
      <% if (user?.id === product.user_id) { %>
        <a href="/products/<%= product.id %>/edit" class="btn btn-sm btn-dark">Editar</a>
      <% } else if (product.stock === 0) { %>
        <span class="text-body-secondary">Esgotado</span>
      <% } else if (user) { %>
        <form action="/cart/items" method="post">
          <%- include('../csrf.ejs') %>
          <input type="hidden" name="productId" value="<%= product.id %>">
          <button type="submit" class="btn btn-sm btn-dark">
            <i class="bi bi-cart-plus"></i> Carrinho
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-dark">Entrar para comprar</a>
      <% } %>
    </div>
  </div>
</article>
