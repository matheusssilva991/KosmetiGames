<header class="container-fluid bg-dark text-white d-flex align-items-center px-5 py-3 justify-content-between">
    <h1 class="h1 m-0">
        <a href="/products" class="text-white text-decoration-none">
            KosmetiGames
        </a>
    </h1>

    <% if (user) { %>
        <nav class="d-flex justify-content-end" id="header-form-nav">
            <ul class="nav d-flex gap-4">
                <li class="nav-item px-2">
                    <div class="dropdown">
                        <button class="btn text-white dropdown-toggle d-flex align-items-center gap-2 py-0 header-nav-item"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person fs-3"></i>
                            <span class="header-nav-link-text"><%= user.name %></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/account">Editar Perfil</a></li>
                            <li><a class="dropdown-item" href="/account/products">Meus Produtos</a></li>
                            <li><a class="dropdown-item" href="/account/orders">Produtos adquiridos</a></li>
                            <li>
                                <form action="/logout" method="post">
                                    <%- include('./csrf.ejs') %>
                                    <button type="submit" class="dropdown-item">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item d-flex align-items-center header-nav-item px-2">
                    <a href="/cart" class="nav-link text-white d-flex align-items-center gap-2 p-0">
                        <i class="bi bi-cart fs-4"></i>
                    </a>
                </li>
            </ul>
        </nav>

    <% } else { %>
        <nav class="d-flex justify-content-end" id="header-form-nav">
            <ul class="nav d-flex gap-4">
                <li class="nav-item px-2 header-nav-item">
                    <a href="/login" class="nav-link text-white d-flex align-items-center gap-2 p-0">
                        <i class="bi bi-person fs-3"></i>
                        <span class="header-nav-link-text">
                            Entrar ou registrar
                        </span>
                    </a>
                </li>
            </ul>
        </nav>
    <% } %>
</header>
